# --- Arcads AI Video skill pack (installed from krusemediallc/arcads-claude-code) ---
.env
.env.*
!.env.example
MASTER_CONTEXT.md
.claude/worktrees/
.claude/settings.local.json
.cursor/skills/
__pycache__/
*.pyc
outputs/
output/

# Reference media is local-only (face photos, product shots, style boards).
# Drop files into references/influencers/, references/products/,
# references/aesthetics/ — they stay on your machine, not in git.
references/*
!references/*/
!references/*/.gitkeep
!references/.gitignore
