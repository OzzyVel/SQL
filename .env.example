# Copy this file to .env and fill in your credentials (never commit .env).

# Free Gemini API key for image generation (skills/gemini-image-gen).
# Get one at https://aistudio.google.com/apikey -- Google account only,
# no credit card required. Free tier has a daily rate limit; see
# skills/gemini-image-gen/SKILL.md for details.
GEMINI_API_KEY=your_key_here

# Optional -- override the default image model (gemini-2.5-flash-image).
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
